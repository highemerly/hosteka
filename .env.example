# hosteka 環境変数のテンプレート
# このファイルをコピーして .env を作成する:  cp .env.example .env
# 実際の値は絶対にコミットしないこと（.env / .env.local は .gitignore 済み）。

# ---------------------------------------------------------------------------
# データベース
# ---------------------------------------------------------------------------
# PostgreSQL の接続文字列。prisma/schema.prisma の datasource が参照する。
# ローカル開発では docker-compose.yml の postgres サービスに接続する。
DATABASE_URL="postgresql://handon_user:handon_password@localhost:5432/handon_login"

# ---------------------------------------------------------------------------
# 認証
# ---------------------------------------------------------------------------
# アプリのベースURL。OAuth の redirect_uri 組み立てにも使われる。
NEXTAUTH_URL="http://localhost:3000"

# ★重要★ この値はセッションの署名だけでなく、
# src/lib/crypto.ts が User.accessToken を暗号化する AES-256-GCM 鍵の導出元でもある。
# ローテートすると保存済みの OAuth アクセストークンが全て復号不能になり、
# Mastodon / Misskey への投稿機能が回復不可能に壊れる。値は変更しないこと。
# 生成: openssl rand -base64 32
NEXTAUTH_SECRET=""

# 定期実行（k8s の CronJob）から保守用の API を叩くときの合言葉。
# NEXTAUTH_SECRET とは別に持つ（あちらは取り替えられない）。取り替えてよい値。
# 空のままなら、合言葉を要求するルートは何を出しても通さない。
CRON_SECRET=""

# ---------------------------------------------------------------------------
# OAuth プロバイダ
# ---------------------------------------------------------------------------
# Mastodon / Misskey / Pleroma はインスタンスごとに動的にアプリ登録するため設定不要。
# Discord と X(Twitter) は開発者コンソールで事前にアプリを作成し、
# redirect_uri に <NEXTAUTH_URL>/api/v1/auth/callback/{discord,twitter} を登録する。
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
TWITTER_CLIENT_ID=""
TWITTER_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# 任意
# ---------------------------------------------------------------------------
# "true" のとき /api/v1/auth/dev-login と同意リセットが有効になる。本番では絶対に設定しない。
DEV_MODE_ENABLED="true"

# 別の端末から `npm run dev` を開くときに許すホスト（カンマ区切り）。next dev でしか効かない。
# ALLOWED_DEV_ORIGINS="192.168.1.10"
