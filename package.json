{
  "name": "hosteka",
  "version": "2.0.2",
  "private": true,
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "openapi": "UPDATE_OPENAPI=1 vitest run src/server/openapi",
    "deploy:migrate": "npx prisma migrate deploy",
    "seed": "npx tsx prisma/seed.ts",
    "seed:dummy": "npx tsx prisma/seed-dummy.ts",
    "cron:maintenance": "npx tsx --conditions=react-server scripts/maintenance.ts",
    "seed:mock-event": "npx tsx prisma/seed-mock-event.ts",
    "seed:mock-pre-event": "npx tsx prisma/seed-mock-pre-event.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@tanstack/react-query": "^5.104.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookies-next": "^6.0.0",
    "ics": "^3.8.1",
    "jose": "^6.2.15",
    "lucide-react": "^1.48.0",
    "next": "^16.3.6",
    "prisma": "^7.10.0",
    "radix-ui": "^1.6.7",
    "react": "^19.1.5",
    "react-dom": "^19.1.5",
    "react-hook-form": "^7.89.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.18.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vitest": "^5.0.5"
  }
