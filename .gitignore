# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# Playwright
/test-results/
/playwright-report/
/tests/.auth/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# テンプレートだけは入れる（docs/development.md のセットアップが cp .env.example .env から始まる）
!.env.example

# database files
*.db
.data/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# E2E（Playwright の出力と、毎回作る偽サーバーの証明書）
/e2e/test-results/
/e2e/playwright-report/
/e2e/fakeverse/certs/
