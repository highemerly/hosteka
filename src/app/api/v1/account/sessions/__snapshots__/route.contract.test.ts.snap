// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`DELETE /api/v1/account/sessions > この端末以外を失効させる 1`] = `
{
  "body": {
    "data": {
      "revoked": 1,
    },
  },
  "contentType": "application/json",
  "status": 200,
}
`;

exports[`DELETE /api/v1/account/sessions > 未ログインでは401 1`] = `
{
  "body": {
    "error": {
      "code": "UNAUTHENTICATED",
      "message": "ログインが必要です",
      "requestId": "<uuid>",
    },
  },
  "contentType": "application/json",
  "status": 401,
}
`;

