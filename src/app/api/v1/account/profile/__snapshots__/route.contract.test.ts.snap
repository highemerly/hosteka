    "error": {
      "code": "VALIDATION_ERROR",
      "details": [
        {
          "message": "サーバーは必須です",
          "path": "socialAccounts.0.server",
        },
        {
          "message": "Xのサーバーは x.com です",
          "path": "socialAccounts.0.server",
        },
      ],
      "message": "リクエストボディの内容が不正です",
      "requestId": "<uuid>",
    },
  },
  "contentType": "application/json",
  "status": 400,
}
`;

