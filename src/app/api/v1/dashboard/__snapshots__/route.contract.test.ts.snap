exports[`GET /api/v1/dashboard > セッションはあるのにユーザーの行が無いときも401。退会直後の取り残しで500にしない 1`] = `
{
  "body": {
    "error": {
      "code": "UNAUTHENTICATED",
      "message": "ログインが必要です",
      "requestId": "<uuid>",
    },
  },
  "contentType": "application/json",
  "status": 401,
}
`;

