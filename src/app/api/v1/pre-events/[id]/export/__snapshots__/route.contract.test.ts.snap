// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`GET /api/v1/pre-events/[id]/export > 主催者・幹事でなければ403 1`] = `
{
  "body": {
    "error": {
      "code": "FORBIDDEN",
      "message": "日程調整のエクスポートは主催者・幹事のみ可能です",
      "requestId": "<uuid>",
    },
  },
  "contentType": "application/json",
  "status": 403,
}
`;

exports[`GET /api/v1/pre-events/[id]/export > 未ログインは401 1`] = `
{
  "body": {
    "error": {
      "code": "UNAUTHENTICATED",
      "message": "ログインが必要です",
      "requestId": "<uuid>",
    },
  },
  "contentType": "application/json",
  "status": 401,
}
`;
