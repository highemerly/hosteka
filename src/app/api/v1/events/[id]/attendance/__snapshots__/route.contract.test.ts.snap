exports[`POST /api/v1/events/[id]/attendance > 知らない出欠の値は400 1`] = `
{
  "body": {
    "error": {
      "code": "VALIDATION_ERROR",
      "details": [
        {
          "message": "Invalid option: expected one of "present"|"absent"|"not_entered"",
          "path": "attendStatus",
        },
      ],
      "message": "リクエストボディの内容が不正です",
      "requestId": "<uuid>",
    },
  },
  "contentType": "application/json",
  "status": 400,
}
`;
