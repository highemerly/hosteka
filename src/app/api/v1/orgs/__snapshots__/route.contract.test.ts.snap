exports[`POST /api/v1/orgs > グループ名が空なら400 1`] = `
{
  "body": {
    "error": {
      "code": "VALIDATION_ERROR",
      "details": [
        {
          "message": "グループ名は必須です",
          "path": "name",
        },
      ],
      "message": "リクエストボディの内容が不正です",
      "requestId": "<uuid>",
    },
  },
  "contentType": "application/json",
  "status": 400,
}
`;

exports[`POST /api/v1/orgs > 不正な形式のグループIDは400 1`] = `
