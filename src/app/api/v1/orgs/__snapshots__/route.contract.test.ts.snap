        {
          "message": "グループIDは4文字以上50文字以内の英数字、ハイフン、アンダースコアで入力してください",
          "path": "slug",
        },
      ],
      "message": "リクエストボディの内容が不正です",
      "requestId": "<uuid>",
    },
  },
  "contentType": "application/json",
  "status": 400,
}
`;

